<aside class="role-sidebar" id="role-sidebar" aria-label="Filter by role">
  <div class="role-sidebar-header">
    <h6>Filter by role</h6>
    <button class="role-sidebar-close" id="role-sidebar-close" aria-label="Close role filter">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <div class="role-sidebar-body">
    <p style="font-size:11px;color:var(--fg-muted);margin-bottom:var(--space-3);line-height:1.4;">Select your role to highlight the most relevant documents and tests.</p>
    <button class="role-btn" data-role="all" data-highlight-docs="" data-highlight-layers="legal,architecture,protocol,credential_format,etsi">
      <span class="role-btn-icon">🌐</span>
      <span>
        <div class="role-btn-label">All roles</div>
        <div class="role-btn-desc">Highlight all documents</div>
      </span>
    </button>
    {% for role in documents.roles %}
    <button class="role-btn" data-role="{{ role.key }}" data-highlight-docs="{{ role.highlightDocs | join(',') }}" data-highlight-layers="{{ role.highlightLayers | join(',') }}">
      <span class="role-btn-icon">{{ role.icon }}</span>
      <span>
        <div class="role-btn-label">{{ role.label }}</div>
        <div class="role-btn-desc">{{ role.description }}</div>
      </span>
    </button>
    {% endfor %}
  </div>
  <div class="role-sidebar-footer">
    <button class="role-clear-btn" id="role-clear-btn">Clear role filter</button>
  </div>
</aside>
