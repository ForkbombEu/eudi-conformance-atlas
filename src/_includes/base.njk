<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title !== 'EUDI Trust & Conformance Atlas' %}{{ title }} — {% endif %}EUDI Trust & Conformance Atlas</title>
  <meta name="description" content="{{ description or 'A community-maintained map of EUDI Wallet law, implementing acts, ARF requirements, WE BUILD trust work, and conformance evidence.' }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/app.css' | url }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/credimi_logo.svg' | url }}">
</head>
<body>
  {% include "credimi-extras-banner-top.njk" %}
  {% include "topbar.njk" %}

  <div class="page-shell" id="page-shell">
    <div class="page-shell-main">
      <main>
        {{ content | safe }}
      </main>
      {% include "footer.njk" %}
    </div>
  </div>

  {% include "role-sidebar.njk" %}

  <script src="{{ '/js/roles.js' | url }}"></script>
  {% if pageScript %}
  <script type="module" src="{{ ('/js/' + pageScript) | url }}"></script>
  {% endif %}
</body>
</html>
