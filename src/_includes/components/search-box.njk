{% macro searchBox(id, placeholder) %}
<div class="search-wrap">
  <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
  <input type="search"
    id="{{ id or 'search-input' }}"
    placeholder="{{ placeholder or 'Find documents, evidence claims, and references:' }}"
    autocomplete="off"
    aria-label="Search">
</div>
{% endmacro %}
