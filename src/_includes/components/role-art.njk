{#
  Role illustrations (large, home page) and line icons (small, role sidebar).
  Decorative only: callers mark them aria-hidden and show the role name as text.
  Colours come from theme tokens through classes in app.css.
#}

{% macro roleArt(key) %}
<svg class="role-art" viewBox="0 0 240 150" aria-hidden="true" focusable="false">
  {% if key == "wallet-builder" %}
  <!-- Phone device + certified badge -->
  <rect class="ra-device" x="85" y="18" width="70" height="114" rx="12"/>
  <rect class="ra-screen" x="92" y="28" width="56" height="94" rx="6"/>
  <rect class="ra-card" x="98" y="42" width="44" height="28" rx="4"/>
  <circle class="ra-accent-success" cx="108" cy="56" r="4"/>
  <rect class="ra-line-fill" x="116" y="52" width="18" height="4" rx="2"/>
  <rect class="ra-line-fill" x="116" y="60" width="12" height="4" rx="2"/>
  <rect class="ra-line-fill" x="102" y="80" width="36" height="4" rx="2"/>
  <rect class="ra-line-fill" x="102" y="90" width="24" height="4" rx="2"/>
  <rect class="ra-button" x="112" y="104" width="16" height="6" rx="3"/>
  <circle class="ra-badge-success" cx="178" cy="38" r="18"/>
  <path class="ra-check" d="M169 38 L175 44 L187 31"/>

  {% elif key == "issuer" %}
  <!-- Official institution + issued credential card -->
  <path class="ra-roof" d="M45 58 L90 30 L135 58 Z"/>
  <rect class="ra-device" x="52" y="58" width="76" height="8" rx="2"/>
  <rect class="ra-column" x="60" y="70" width="10" height="38" rx="2"/>
  <rect class="ra-column" x="85" y="70" width="10" height="38" rx="2"/>
  <rect class="ra-column" x="110" y="70" width="10" height="38" rx="2"/>
  <rect class="ra-device" x="45" y="112" width="90" height="8" rx="2"/>
  <path class="ra-arrow" d="M138 82 C 146 80, 152 78, 158 76"/>
  <path class="ra-arrow-head" d="M150 70 L160 75 L151 82"/>
  <rect class="ra-card" x="162" y="58" width="48" height="34" rx="5"/>
  <circle class="ra-accent-warning" cx="174" cy="72" r="4"/>
  <rect class="ra-line-fill" x="182" y="68" width="20" height="4" rx="2"/>
  <rect class="ra-line-fill" x="182" y="76" width="14" height="4" rx="2"/>

  {% elif key == "verifier" %}
  <!-- Verification terminal screen + QR scan -->
  <rect class="ra-device" x="58" y="24" width="112" height="76" rx="8"/>
  <rect class="ra-screen" x="66" y="32" width="96" height="60" rx="4"/>
  <g class="ra-qr">
    <rect x="76" y="42" width="16" height="16" rx="2"/><rect x="76" y="68" width="16" height="16" rx="2"/>
    <rect x="102" y="42" width="16" height="16" rx="2"/><rect x="100" y="62" width="7" height="7"/>
    <rect x="110" y="68" width="7" height="7"/><rect x="102" y="77" width="7" height="7"/>
  </g>
  <rect class="ra-line-fill" x="128" y="48" width="24" height="4" rx="2"/>
  <rect class="ra-line-fill" x="128" y="58" width="18" height="4" rx="2"/>
  <rect class="ra-line-fill" x="128" y="68" width="22" height="4" rx="2"/>
  <path class="ra-device" d="M46 112 H182 L172 124 H56 Z"/>
  <circle class="ra-badge-success" cx="180" cy="38" r="18"/>
  <path class="ra-check" d="M171 38 L177 44 L189 31"/>

  {% elif key == "member-state" %}
  <!-- EU Star Ring (12 stars centered) -->
  <circle class="ra-seal-inner" cx="120" cy="75" r="28"/>
  <circle class="ra-star" cx="120" cy="29" r="5.5"/>
  <circle class="ra-star" cx="143" cy="35" r="5.5"/>
  <circle class="ra-star" cx="160" cy="52" r="5.5"/>
  <circle class="ra-star" cx="166" cy="75" r="5.5"/>
  <circle class="ra-star" cx="160" cy="98" r="5.5"/>
  <circle class="ra-star" cx="143" cy="115" r="5.5"/>
  <circle class="ra-star" cx="120" cy="121" r="5.5"/>
  <circle class="ra-star" cx="97" cy="115" r="5.5"/>
  <circle class="ra-star" cx="80" cy="98" r="5.5"/>
  <circle class="ra-star" cx="74" cy="75" r="5.5"/>
  <circle class="ra-star" cx="80" cy="52" r="5.5"/>
  <circle class="ra-star" cx="97" cy="35" r="5.5"/>

  {% else %}
  <!-- Audit clipboard + official seal -->
  <rect class="ra-device" x="68" y="18" width="74" height="112" rx="7"/>
  <rect class="ra-screen" x="76" y="28" width="58" height="92" rx="4"/>
  <rect class="ra-clip" x="90" y="12" width="30" height="14" rx="3"/>
  <path class="ra-check-small" d="M84 46 L88 50 L96 41"/><rect class="ra-line-fill" x="102" y="44" width="24" height="4" rx="2"/>
  <path class="ra-check-small" d="M84 66 L88 70 L96 61"/><rect class="ra-line-fill" x="102" y="64" width="20" height="4" rx="2"/>
  <path class="ra-check-small" d="M84 86 L88 90 L96 81"/><rect class="ra-line-fill" x="102" y="84" width="22" height="4" rx="2"/>
  <circle class="ra-seal" cx="166" cy="92" r="20"/>
  <circle class="ra-seal-inner" cx="166" cy="92" r="12"/>
  <path class="ra-ribbon" d="M156 108 L150 124 L160 118 L166 125 L172 118 L182 124 L176 108"/>
  {% endif %}
</svg>
{% endmacro %}

{% macro roleIcon(key) %}
<svg class="role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% if key == "wallet-builder" %}<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 6h4"/><rect x="9" y="10" width="6" height="4" rx="1"/>
  {% elif key == "issuer" %}<path d="M3 10 12 4l9 6"/><path d="M5 10v8M10 10v8M14 10v8M19 10v8"/><path d="M3 20h18"/>
  {% elif key == "verifier" %}<path d="M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M20 17v2a1 1 0 0 1-1 1h-2M7 20H5a1 1 0 0 1-1-1v-2"/><path d="m8 12 3 3 5-6"/>
  {% elif key == "member-state" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v.01M17 12h.01M12 17v.01M7 12h.01M15.5 8.5h.01M15.5 15.5h.01M8.5 15.5h.01M8.5 8.5h.01"/>
  {% elif key == "cab-nab" %}<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2h6v4H9z"/><path d="m9 13 2 2 4-4"/>
  {% else %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
  {% endif %}
</svg>
{% endmacro %}
