{#
  Role illustrations (large, home page) and line icons (small, role sidebar).
  Decorative only: callers mark them aria-hidden and show the role name as text.
  Colours come from theme tokens through classes in app.css.
#}

{% macro roleArt(key) %}
<svg class="role-art" viewBox="0 0 240 150" aria-hidden="true" focusable="false">
  {% if key == "wallet-builder" %}
  <rect class="ra-device" x="78" y="18" width="76" height="118" rx="14"/>
  <rect class="ra-screen" x="86" y="30" width="60" height="94" rx="6"/>
  <rect class="ra-card" x="94" y="46" width="44" height="30" rx="6"/>
  <circle class="ra-accent-success" cx="106" cy="60" r="4.5"/>
  <rect class="ra-line-fill" x="116" y="56" width="16" height="4" rx="2"/>
  <rect class="ra-line-fill" x="116" y="66" width="12" height="4" rx="2"/>
  <rect class="ra-button" x="108" y="104" width="16" height="7" rx="3.5"/>
  <circle class="ra-badge-success" cx="182" cy="40" r="20"/>
  <path class="ra-check" d="M172 40 L179 47 L192 33"/>
  {% elif key == "issuer" %}
  <path class="ra-roof" d="M48 72 L92 42 L136 72 Z"/>
  <rect class="ra-device" x="56" y="72" width="72" height="8" rx="2"/>
  <rect class="ra-column" x="64" y="84" width="11" height="36" rx="2"/>
  <rect class="ra-column" x="86" y="84" width="11" height="36" rx="2"/>
  <rect class="ra-column" x="108" y="84" width="11" height="36" rx="2"/>
  <rect class="ra-device" x="48" y="120" width="88" height="8" rx="2"/>
  <path class="ra-arrow" d="M138 92 C 152 90, 162 88, 172 86"/>
  <path class="ra-arrow-head" d="M164 79 L174 85 L164 92"/>
  <rect class="ra-card" x="178" y="70" width="46" height="32" rx="6"/>
  <circle class="ra-accent-warning" cx="190" cy="84" r="4.5"/>
  <rect class="ra-line-fill" x="198" y="80" width="20" height="4" rx="2"/>
  <rect class="ra-line-fill" x="198" y="89" width="14" height="4" rx="2"/>
  {% elif key == "verifier" %}
  <rect class="ra-device" x="52" y="32" width="112" height="78" rx="8"/>
  <rect class="ra-screen" x="60" y="40" width="96" height="62" rx="4"/>
  <g class="ra-qr">
    <rect x="72" y="50" width="15" height="15" rx="2"/><rect x="72" y="78" width="15" height="15" rx="2"/>
    <rect x="100" y="50" width="15" height="15" rx="2"/><rect x="96" y="70" width="7" height="7"/>
    <rect x="108" y="78" width="7" height="7"/><rect x="100" y="89" width="7" height="7"/>
  </g>
  <rect class="ra-line-fill" x="126" y="56" width="26" height="5" rx="2.5"/>
  <rect class="ra-line-fill" x="126" y="66" width="18" height="5" rx="2.5"/>
  <rect class="ra-line-fill" x="126" y="76" width="22" height="5" rx="2.5"/>
  <path class="ra-device" d="M38 116 H176 L168 128 H46 Z"/>
  <circle class="ra-badge-success" cx="176" cy="40" r="19"/>
  <path class="ra-check" d="M167 40 L174 47 L185 33"/>
  {% elif key == "member-state" %}
  <circle class="ra-star" cx="170" cy="78" r="3.5"/>
  <circle class="ra-star" cx="181" cy="81" r="3.5"/>
  <circle class="ra-star" cx="189" cy="89" r="3.5"/>
  <circle class="ra-star" cx="192" cy="100" r="3.5"/>
  <circle class="ra-star" cx="189" cy="111" r="3.5"/>
  <circle class="ra-star" cx="181" cy="119" r="3.5"/>
  <circle class="ra-star" cx="170" cy="122" r="3.5"/>
  <circle class="ra-star" cx="159" cy="119" r="3.5"/>
  <circle class="ra-star" cx="151" cy="111" r="3.5"/>
  <circle class="ra-star" cx="148" cy="100" r="3.5"/>
  <circle class="ra-star" cx="151" cy="89" r="3.5"/>
  <circle class="ra-star" cx="159" cy="81" r="3.5"/>
  {% else %}
  <rect class="ra-device" x="66" y="26" width="88" height="112" rx="8"/>
  <rect class="ra-screen" x="75" y="39" width="70" height="90" rx="4"/>
  <rect class="ra-clip" x="98" y="18" width="30" height="15" rx="4"/>
  <path class="ra-check-small" d="M86 58 L90 62 L98 53"/><rect class="ra-line-fill" x="106" y="54" width="28" height="5" rx="2.5"/>
  <path class="ra-check-small" d="M86 80 L90 84 L98 75"/><rect class="ra-line-fill" x="106" y="76" width="22" height="5" rx="2.5"/>
  <path class="ra-check-small" d="M86 102 L90 106 L98 97"/><rect class="ra-line-fill" x="106" y="98" width="26" height="5" rx="2.5"/>
  <circle class="ra-seal" cx="168" cy="110" r="22"/>
  <circle class="ra-seal-inner" cx="168" cy="110" r="14"/>
  <path class="ra-ribbon" d="M158 128 L152 146 L162 139 L168 147 L174 139 L184 146 L178 128"/>
  {% endif %}
</svg>
{% endmacro %}

{% macro roleIcon(key) %}
<svg class="role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% if key == "wallet-builder" %}<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 6h4"/><rect x="9" y="10" width="6" height="4" rx="1"/>
  {% elif key == "issuer" %}<path d="M3 10 12 4l9 6"/><path d="M5 10v8M10 10v8M14 10v8M19 10v8"/><path d="M3 20h18"/>
  {% elif key == "verifier" %}<path d="M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M20 17v2a1 1 0 0 1-1 1h-2M7 20H5a1 1 0 0 1-1-1v-2"/><path d="m8 12 3 3 5-6"/>
  {% elif key == "member-state" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v.01M17 12h.01M12 17v.01M7 12h.01M15.5 8.5h.01M15.5 15.5h.01M8.5 15.5h.01M8.5 8.5h.01"/>
  {% elif key == "cab-nab" %}<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2h6v4H9z"/><path d="m9 13 2 2 4-4"/>
  {% else %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
  {% endif %}
</svg>
{% endmacro %}
