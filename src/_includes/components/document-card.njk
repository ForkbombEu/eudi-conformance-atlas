{% macro documentCard(doc) %}
<div class="card doc-card highlightable" data-doc-id="{{ doc.id }}" data-layer="{{ doc.layer }}">
  <div class="doc-card-flags">
    <span class="status-pill tone-{{ doc.statusTone }}">{{ doc.statusGlyph }} {{ doc.statusLabel }}</span>
    {% if doc.status_date %}<span class="doc-date">{{ doc.status_date | statusDate }}</span>{% endif %}
    {% if doc.arf_essential_for %}<span class="badge badge-technical" title="Essential standard in the ARF STS list">★ ARF essential</span>{% endif %}
    {% if doc.releaseChange %}<span class="change-tag change-{{ doc.releaseChange }}">{{ doc.releaseChange }}</span>{% endif %}
  </div>
  <h4><a href="{{ ('/documents/' + doc.id + '/') | url }}">{{ doc.name }}</a></h4>
  <div class="doc-id">{{ doc.id }}</div>
  {% if doc.summary %}
  <p class="doc-summary">{{ doc.summary }}</p>
  {% endif %}
  <div class="doc-meta">
    <span class="badge {{ doc.typeBadge }}">{{ doc.typeLabel }}</span>
    {% if doc.url %}
    <a href="{{ doc.url }}" target="_blank" rel="noopener" class="doc-official">Official ↗</a>
    {% endif %}
  </div>
</div>
{% endmacro %}
