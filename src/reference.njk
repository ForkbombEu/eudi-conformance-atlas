---
layout: base.njk
title: Reference
description: Unified searchable catalogue of all EUDI documents — EU law, EC specifications, ETSI/CEN/ISO standards and OpenID/IETF/W3C specs — with adoption status.
pageScript: search.js
---
{% from "components/search-box.njk" import searchBox %}
{% from "components/document-card.njk" import documentCard %}
{% from "components/credimi.njk" import credimiCta %}

<section class="hero page-hero">
  <div class="hero-inner">
    <p class="eyebrow">Unified catalogue</p>
    <h1>Reference</h1>
    <p>All {{ documents.totalCount }} documents — EU law, EC technical specifications, standards and protocols. Filter by layer, adoption status or type.</p>
    <div class="page-hero-meta">
      {% for s in documents.statusSummary %}<span class="status-pill tone-{{ s.tone }}">{{ s.glyph }} {{ s.count }} {{ (s.plural or s.label) | lower }}</span>{% endfor %}
    </div>
  </div>
</section>

<div class="page-content">
  <div class="container">
    <div class="disclaimer">
      <strong>Disclaimer:</strong> Unofficial navigation resource. Always refer to EUR-Lex and official repositories for authoritative texts.
    </div>

    <div class="ref-toolbar">
      {{ searchBox("doc-search", "Find documents by name, ID, or summary…", "q") }}
      <div class="ref-toolbar-actions">
        <a href="{{ '/data/eudi-documents-map.yaml' | url }}" class="btn btn-outline btn-sm" download>↓ YAML</a>
        <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/data/eudi-documents-map.yaml" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">GitHub →</a>
      </div>
    </div>

    <div class="ref-source-tabs" id="stack-tabs" role="tablist" aria-label="Stack layer">
      <button class="ref-source-tab active" data-stack="all" role="tab" aria-selected="true">All <span class="count-chip">{{ documents.totalCount }}</span></button>
      {% for stack in documents.stacks %}
      <button class="ref-source-tab" data-stack="{{ stack.key }}" role="tab" aria-selected="false">{{ stack.label }} <span class="count-chip">{{ stack.count }}</span></button>
      {% endfor %}
    </div>

    <div class="filter-group">
      <span class="filter-group-label" id="status-filter-label">Status</span>
      <div class="filter-bar" id="status-filter" role="group" aria-labelledby="status-filter-label">
        {% for s in documents.statusSummary %}
        <button class="filter-chip" data-filter="status" data-value="{{ s.key }}" aria-pressed="false">{{ s.glyph }} {{ s.label }}</button>
        {% endfor %}
        <button class="filter-chip" data-filter="change" data-value="changed" aria-pressed="false">✚ New or updated</button>
        <button class="filter-chip" data-filter="essential" data-value="yes" aria-pressed="false">★ ARF essential</button>
      </div>
    </div>

    <div class="filter-group">
      <span class="filter-group-label" id="type-filter-label">Type</span>
      <div class="filter-bar" id="type-filter" role="group" aria-labelledby="type-filter-label">
        {% for typeKey, count in documents.typeCounts %}
        <button class="filter-chip" data-filter="type" data-value="{{ typeKey }}" aria-pressed="false">{{ typeKey | sourceTypeLabel }} · {{ count }}</button>
        {% endfor %}
      </div>
    </div>

    <p class="ref-results" id="ref-results" aria-live="polite">Showing {{ documents.totalCount }} documents</p>

    <div class="card-grid card-grid-2" id="doc-list">
      {% for doc in documents.documents %}
      <div class="doc-item highlightable"
           data-type="{{ doc.type }}"
           data-stack="{{ doc.stack }}"
           data-status="{{ doc.status }}"
           data-change="{{ 'changed' if doc.releaseChange else '' }}"
           data-essential="{{ 'yes' if doc.arf_essential_for else '' }}"
           data-layer="{{ doc.layer }}"
           data-doc-id="{{ doc.id }}"
           data-search="{{ doc.id }} {{ doc.name }} {{ doc.summary or '' }} {{ doc.typeLabel }} {{ doc.statusLabel }}">
        {{ documentCard(doc) }}
      </div>
      {% endfor %}
    </div>
    <p class="empty-state" id="doc-empty" hidden>No documents match these filters. Clear a filter or try another search term.</p>

    <div class="home-section">
      {{ credimiCta("Turn these references into a test plan.", "Credimi runs automated conformance and interoperability pipelines against real Wallets, Issuers and Verifiers, so the requirements you filter here can become evidence for your implementation.") }}
    </div>

    <div class="page-end">
      <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/src/reference.njk" class="edit-link" target="_blank" rel="noopener">Edit this page on GitHub</a>
    </div>
  </div>
</div>
