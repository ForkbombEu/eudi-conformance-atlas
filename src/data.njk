---
layout: base.njk
title: Data & Downloads
description: Raw machine-readable data files powering the EUDI Atlas.
permalink: /data/
---
{% from "components/section-header.njk" import sectionHeader %}
{% from "components/source-badge.njk" import sourceBadge %}
{% from "components/credimi.njk" import credimiCta %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}

<section class="hero page-hero">
  <div class="hero-inner">
    <p class="eyebrow">MACHINE-READABLE DATA</p>
    <h1>Data & Downloads</h1>
    <p>Raw YAML and JSON files powering this site. Free to download, fork, and use under Apache-2.0.</p>
  </div>
</section>

<div class="page-content">
  <div class="container">
    {{ breadcrumbs([{label:"Home", url:"/"}, {label:"Data & Downloads", url:"/data/"}]) }}
    <div class="disclaimer">
      <strong>Disclaimer:</strong> Not official EU publications. Official sources always prevail. Licensed Apache-2.0.
    </div>

    {{ sectionHeader("Current source of truth") }}
    <div class="card mb-8">
      <h4 class="card-title">Current source of truth: {{ sourceOfTruth.current_release }}</h4>
      <p class="text-sm text-muted mb-3">Release date: {{ sourceOfTruth.release_date }}</p>
      <p class="mb-4"><a href="{{ '/data/source-of-truth/current.json' | url }}" class="btn btn-outline btn-sm" download>Download current.json</a></p>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Filename</th>
              <th>Media type</th>
              <th class="num">Bytes</th>
              <th class="num"></th>
            </tr>
          </thead>
          <tbody>
            {% for artifact in sourceOfTruth.artifacts %}
            <tr>
              <td>{{ artifact.filename }}</td>
              <td class="font-mono">{{ artifact.media_type }}</td>
              <td class="num">{{ artifact.byte_size }}</td>
              <td class="num"><a href="{{ ('/' + artifact.path) | url }}" class="btn btn-outline btn-sm" download>Download</a></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card-grid card-grid-2 mb-8">
      <div class="card">
        <h4 class="card-title">EUDI Documents Map</h4>
        <p class="text-sm text-muted mb-3">{{ documents.totalCount }} documents across {{ documents.stacks | length }} stack layers, each with adoption status. Version {{ documents.version }}{% if documents.latestRelease %}, reviewed {{ documents.latestRelease.date | statusDate }}{% endif %}.</p>
        <div class="flex gap-2">
          <a href="{{ '/data/eudi-documents-map.yaml' | url }}" class="btn btn-outline btn-sm" download>Download YAML</a>
          <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/data/eudi-documents-map.yaml" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>
      <div class="card">
        <h4 class="card-title">FCAF Test Catalogue</h4>
        <p class="text-sm text-muted mb-3">{{ fcaf.totalCount }} wallet-solution test cases across {{ fcaf.roles.length }} roles and {{ fcaf.sectionCount }} sections, with normative references. Imported from <span class="mono">{{ fcaf.source.upstream_commit | truncate(12) }}</span>.</p>
        <div class="flex gap-2">
          <a href="{{ '/data/fcaf.yaml' | url }}" class="btn btn-outline btn-sm" download>Download YAML</a>
          <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/data/fcaf.yaml" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>
    </div>

    {{ sectionHeader("Document counts by type") }}
    <div class="card mb-8">
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Type</th>
              <th class="num">Count</th>
            </tr>
          </thead>
          <tbody>
            {% for typeName, typeCount in documents.typeCounts %}
            <tr>
              <td>{{ sourceBadge(typeName) }} {{ typeName }}</td>
              <td class="num">{{ typeCount }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="home-section">
      {{ credimiCta("Turn this data into a test plan.", "Download the documents map and run it through Credimi's automated conformance pipelines, so the references here become evidence for your implementation.") }}
    </div>
  </div>
</div>
