---
layout: base.njk
title: EUDI Trust & Conformance Atlas
description: A community-maintained map of EUDI Wallet law, implementing acts, ARF requirements, standards, protocols and conformance evidence — with adoption status for every document.
---
{% from "components/section-header.njk" import sectionHeader %}
{% from "components/search-box.njk" import searchBox %}
{% from "components/credimi.njk" import credimiCta, credimiPromo %}
{% from "components/viz.njk" import radarChart %}
{% from "components/role-art.njk" import roleArt %}

<section class="atlas-hero">
  <div class="atlas-hero-inner">
    <div>
      <p class="eyebrow">Community-maintained · {% if documents.latestRelease %}updated {{ documents.latestRelease.date | statusDate }}{% endif %}</p>
      <h1>The EUDI Wallet rulebook, <em>mapped</em>.</h1>
      <p class="atlas-hero-lead">{{ site.documentsLabel }} laws, implementing acts, EC specifications, standards and protocols — each with its adoption status, plus {{ site.fcafLabel }} FCAF test cases for wallet solutions.</p>
      <form class="atlas-hero-search" action="{{ '/reference/' | url }}" method="get" role="search">
        {{ searchBox("landing-search", "Search e.g. HAIP, 2024/2982, Trusted Lists…", "q") }}
        <button class="btn btn-on-dark btn-lg" type="submit">Search</button>
      </form>
      <div class="atlas-hero-actions">
        <a href="{{ '/map/' | url }}" class="btn btn-on-dark btn-lg">Explore the map</a>
        <a href="{{ '/radar/' | url }}" class="btn btn-outline-on-dark btn-lg">Regulatory radar</a>
        <a href="{{ '/fcaf/' | url }}" class="btn btn-outline-on-dark btn-lg">FCAF framework</a>
      </div>
    </div>

    <div>
      <ol class="stack-visual" aria-label="The EUDI rulebook stack, from executable evidence down to the legal foundation">
        <li class="stack-plate stack-plate-evidence" style="--depth: 4">
          <a href="{{ '/fcaf/' | url }}">
            <span><span class="stack-plate-label">Executable evidence</span><span class="stack-plate-sub">FCAF test cases · wallet solutions</span></span>
            <span class="stack-plate-count">{{ fcaf.totalCount }}</span>
          </a>
        </li>
        {% for stack in documents.stacks | reverse %}
        <li class="stack-plate" style="--depth: {{ 3 - loop.index0 }}">
          <a href="{{ ('/reference/?stack=' + stack.key) | url }}">
            <span><span class="stack-plate-label">{{ stack.label }}</span><span class="stack-plate-sub">{{ stack.description | truncate(64) }}</span></span>
            <span class="stack-plate-count">{{ stack.count }}</span>
          </a>
        </li>
        {% endfor %}
      </ol>
      <p class="stack-caption">Each layer builds on the one below it. Select a layer to browse it.</p>
    </div>
  </div>
</section>

<div class="page-content">
  <div class="container">

    <section class="viz-section viz-section-first" aria-labelledby="home-radar-title">
      <div class="viz-grid">
        {{ radarChart(documents.radar) }}
        <div>
          <p class="viz-kicker">Regulatory radar</p>
          <h2 class="viz-title" id="home-radar-title">Every rule, where it stands today</h2>
          <p class="viz-lead">Each dot is one document, placed by stack layer and status. Select a dot to open the document. Ringed dots are new in this edition.</p>
          <ul class="viz-facts">
            <li><strong>{{ documents.currentCount }}</strong><span>in force, published or final</span></li>
            <li><strong>{{ documents.pipelineCount }}</strong><span>drafts and proposals moving</span></li>
            <li><strong>{{ documents.pinnedDocuments.length }}</strong><span>with test-version pins to watch</span></li>
          </ul>
          <div class="viz-actions">
            <a href="{{ '/radar/' | url }}" class="btn btn-primary btn-lg">Open the full radar</a>
            <a href="{{ '/reference/' | url }}" class="btn btn-outline btn-lg">Browse all documents</a>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section">
      {{ sectionHeader("Start here") }}
      <p class="section-intro">Six ways into the same rulebook — every document, standard and test cross-linked across all of them.</p>
      <div class="card-grid card-grid-3">
        <a class="card start-card" href="{{ '/radar/' | url }}">
          <span class="start-card-label">Regulatory radar</span>
          <strong>{{ site.documentsLabel }} documents</strong>
          <p>What is in force, what changed and what is still a draft or proposal.</p>
        </a>
        <a class="card start-card" href="{{ '/reference/' | url }}">
          <span class="start-card-label">Reference</span>
          <strong>Searchable catalogue</strong>
          <p>Filter law, EC specs, standards and protocols by stack, status and type.</p>
        </a>
        <a class="card start-card" href="{{ '/glossary/' | url }}">
          <span class="start-card-label">Glossary</span>
          <strong>{{ site.glossaryLabel }} terms</strong>
          <p>Read the rulebook by topic, with document counts per stack layer.</p>
        </a>
        <a class="card start-card" href="{{ '/map/' | url }}">
          <span class="start-card-label">Map</span>
          <strong>By task</strong>
          <p>The EUDI stack organised by what you are building, with role highlighting.</p>
        </a>
        <a class="card start-card" href="{{ '/fcaf/' | url }}">
          <span class="start-card-label">FCAF framework</span>
          <strong>{{ site.fcafLabel }} test cases</strong>
          <p>The wallet-solution conformance suite by role and section.</p>
        </a>
        <a class="card start-card" href="{{ '/data/' | url }}">
          <span class="start-card-label">Data</span>
          <strong>Machine-readable</strong>
          <p>Download the YAML and JSON that power this atlas.</p>
        </a>
      </div>
    </section>


    <section>
      {{ sectionHeader("What moved recently", null, "/radar/") }}
      <p class="section-intro">The latest status changes across EU law, EC specifications, standards and protocols, and what is still on its way.</p>
      <div class="radar-grid">
        <ol class="timeline">
          {% for doc in documents.timeline | batch(8) | first %}
          <li class="timeline-item">
            <span class="timeline-date">{{ doc.status_date | statusDate }}</span>
            <p class="timeline-title"><a href="{{ ('/documents/' + doc.id + '/') | url }}">{{ doc.name }}</a></p>
            <div class="chip-row">
              <span class="status-pill tone-{{ doc.statusTone }}">{{ doc.statusGlyph }} {{ doc.statusLabel }}</span>
              <span class="badge {{ doc.typeBadge }}">{{ doc.typeLabel }}</span>
              {% if doc.releaseChange %}<span class="change-tag change-{{ doc.releaseChange }}">{{ doc.releaseChange }}</span>{% endif %}
            </div>
          </li>
          {% endfor %}
        </ol>

        <div class="detail-aside">
          <div class="card">
            <h3 class="detail-aside-title">Status at a glance</h3>
            <div class="status-bar" role="img" aria-label="Document status distribution">
              {% for s in documents.statusSummary %}<span class="status-bar-seg" data-tone="{{ s.tone }}" style="--share: {{ s.count }}"></span>{% endfor %}
            </div>
            <ul class="status-legend">
              {% for s in documents.statusSummary %}
              <li><span class="status-pill tone-{{ s.tone }}">{{ s.glyph }} {{ s.label }}</span><strong>{{ s.count }}</strong></li>
              {% endfor %}
            </ul>
          </div>
          <div class="card">
            <h3 class="detail-aside-title">On the watchlist</h3>
            <ul class="watch-list">
              {% set watched = 0 %}
              {% for doc in documents.timeline %}{% if doc.statusPhase == 'pipeline' and watched < 5 %}{% set watched = watched + 1 %}
              <li class="watch-item">
                <a href="{{ ('/documents/' + doc.id + '/') | url }}">
                  <strong>{{ doc.name }}</strong>
                  <span class="chip-row"><span class="status-pill tone-{{ doc.statusTone }}">{{ doc.statusGlyph }} {{ doc.statusLabel }}</span><span class="doc-date">{{ doc.status_date | statusDate }}</span></span>
                </a>
              </li>
              {% endif %}{% endfor %}
            </ul>
            <a href="{{ '/radar/' | url }}" class="see-all">Full radar ↗</a>
          </div>
        </div>
      </div>
    </section>

    <div class="home-section">
      {{ credimiCta("Know which rules apply? Prove you meet them.", "Credimi runs your Wallet, Issuer or Verifier against the flows these documents define and keeps every run as shareable evidence.") }}
    </div>

    <section class="home-section role-section" aria-labelledby="roles-title">
      <p class="viz-kicker">Start by role</p>
      <h2 class="viz-title" id="roles-title">Same rulebook, five ways in</h2>
      <p class="viz-lead">Pick the seat you sit in. The atlas highlights your documents and map entries on every page.</p>
      <ul class="role-row">
        {% for role in documents.roles %}
        <li class="role-panel">
          <div class="role-panel-art">{{ roleArt(role.key) }}</div>
          <div class="role-panel-body">
            <h3><a class="role-panel-link" href="{{ ('/reference/?role=' + role.key) | url }}">{{ role.label }}</a></h3>
            <p>{{ role.tagline }}</p>
            <p class="role-panel-stats"><strong>{{ role.docCount }}</strong> key documents{% if role.movingCount %} · <strong>{{ role.movingCount }}</strong> still moving{% endif %}</p>
            <ul class="role-panel-docs">
              {% for d in role.keyDocs %}
              <li><span class="legend-dot tone-dot-{{ d.statusTone }}" aria-hidden="true"></span><span>{{ d.id }}</span><span class="visually-hidden"> — {{ d.statusLabel }}</span></li>
              {% endfor %}
            </ul>
            <span class="role-panel-more" aria-hidden="true">Open my view →</span>
          </div>
        </li>
        {% endfor %}
      </ul>
    </section>

    <section class="home-section">
      {{ sectionHeader("Recommended reading routes", documents.routes.length) }}
      <div class="card-grid card-grid-2">
        {% for route in documents.routes %}
        <div class="card route-card">
          <h3>{{ route.title }}</h3>
          <p>{{ route.why_this_route }}</p>
          <div class="route-docs">
            {% for docId in route.documents %}
            <a href="{{ ('/documents/' + docId + '/') | url }}" class="badge badge-neutral font-mono">{{ docId }}</a>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <div class="home-section">
      {{ credimiPromo(fcaf.totalCount) }}
    </div>

    <div class="disclaimer home-section">
      <strong>Disclaimer:</strong> Unofficial navigation resource — not legal advice, not certification. <a href="https://eur-lex.europa.eu/" target="_blank" rel="noopener">Official sources</a> always prevail. Maintained by <a href="https://forkbomb.eu" target="_blank" rel="noopener">ForkBomb BV</a> / <a href="https://credimi.io" target="_blank" rel="noopener">Credimi</a>.
    </div>

    <div class="page-end">
      <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/src/index.njk" class="edit-link" target="_blank" rel="noopener">Edit this page on GitHub</a>
    </div>
  </div>
</div>
