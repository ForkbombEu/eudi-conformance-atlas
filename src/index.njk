---
layout: base.njk
title: EUDI Trust & Conformance Atlas
description: A community-maintained map of EUDI Wallet law, implementing acts, ARF requirements, WE BUILD trust work, and conformance evidence.
pageScript: search.js
---
{% from "components/section-header.njk" import sectionHeader %}
{% from "components/search-box.njk" import searchBox %}
{% from "components/document-card.njk" import documentCard %}

<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow">COMMUNITY-MAINTAINED NAVIGATION RESOURCE</p>
    <h1>EUDI Trust &<br>Conformance Atlas</h1>
    <p>A community-maintained map of EUDI Wallet law, implementing acts, ARF requirements, WE BUILD trust work, and conformance-evidence mappings.</p>
    <div style="margin-top: var(--space-6); display: flex; gap: var(--space-3);">
      <a href="{{ '/map/' | url }}" class="btn btn-primary btn-lg">Explore the map</a>
      <a href="{{ '/documents/' | url }}" class="btn btn-outline btn-lg">Browse documents</a>
    </div>
  </div>
</section>

<div class="page-content">
  <div class="container">
    <div class="disclaimer">
      <strong>Disclaimer:</strong> This is an unofficial navigation resource, not legal advice, not certification. Official sources always prevail. Maintained by <strong>Credimi / Forkbomb BV</strong>.
    </div>

    {{ sectionHeader("Find documents, evidence claims, and references", documents.totalCount + evidence.totalCount) }}

    <div style="margin-bottom: var(--space-6);">
      {{ searchBox("landing-search", "Find documents, evidence claims, and references:") }}
    </div>

    <div id="search-results" style="display:none;" class="card-grid card-grid-2"></div>

    <div id="default-content">
      <div style="margin-top: var(--space-6);">
        {{ sectionHeader("Quick links", null, "/documents/") }}
      </div>

      <div class="card-grid card-grid-3 mb-8">
        <a href="{{ '/map/' | url }}" class="card" style="text-decoration:none;">
          <h4 style="color:var(--fg);">Map <span aria-hidden="true">↗</span></h4>
          <p class="text-sm text-muted">Interactive tree of documents, groups, and evidence claims.</p>
        </a>
        <a href="{{ '/documents/' | url }}" class="card" style="text-decoration:none;">
          <h4 style="color:var(--fg);">Documents <span aria-hidden="true">↗</span><span class="count-chip">{{ documents.totalCount }}</span></h4>
          <p class="text-sm text-muted">Legal acts, implementing regulations, ARF, WE BUILD, and more.</p>
        </a>
        <a href="{{ '/evidence/' | url }}" class="card" style="text-decoration:none;">
          <h4 style="color:var(--fg);">Evidence Claims <span aria-hidden="true">↗</span><span class="count-chip">{{ evidence.totalCount }}</span></h4>
          <p class="text-sm text-muted">Reproducible conformance evidence claims with official references.</p>
        </a>
      </div>

      <div style="margin-top: var(--space-6);">
        {{ sectionHeader("Recommended reading routes", documents.routes.length) }}
      </div>

      <div class="card-grid card-grid-2 mb-8">
        {% for route in documents.routes %}
        <div class="card">
          <h4 style="font-size:var(--fs-md);font-weight:700;margin-bottom:var(--space-1);">{{ route.title }}</h4>
          <p style="font-size:var(--fs-sm);color:var(--fg-muted);margin-bottom:var(--space-3);">{{ route.why_this_route }}</p>
          <div style="display:flex;flex-wrap:wrap;gap:var(--space-1);">
            {% for docId in route.documents %}
            <a href="{{ ('/documents/' + docId + '/') | url }}" class="badge badge-neutral font-mono" style="text-decoration:none;">{{ docId }}</a>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>

      <div style="margin-top: var(--space-6);">
        {{ sectionHeader("Recent documents", documents.recentDocuments.length, "/documents/") }}
      </div>

      <div class="card-grid card-grid-2 mb-8">
        {% for doc in documents.recentDocuments %}
        {{ documentCard(doc) }}
        {% endfor %}
      </div>
    </div>

    <div style="margin-top: var(--space-4); text-align: center;">
      <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/src/index.njk" class="edit-link" target="_blank" rel="noopener">Edit this page on GitHub</a>
    </div>
  </div>
</div>
