---
layout: base.njk
pagination:
  data: documents.documents
  size: 1
  alias: doc
  addAllPagesToCollections: true
permalink: "/documents/{{ doc.id }}/index.html"
eleventyComputed:
  title: "{{ doc.name }}"
  description: "{{ doc.summary }}"
---
{% from "components/credimi.njk" import credimiCta %}

<section class="hero page-hero">
  <div class="hero-inner">
    <p class="eyebrow">{{ doc.typeLabel }}</p>
    <h1>{{ doc.name }}</h1>
    <div class="page-hero-meta">
      <span class="status-pill tone-{{ doc.statusTone }}">{{ doc.statusGlyph }} {{ doc.statusLabel }}{% if doc.status_date %} · {{ doc.status_date | statusDate }}{% endif %}</span>
      <span class="badge {{ doc.typeBadge }}">{{ doc.typeLabel }}</span>
      {% if doc.releaseChange %}<span class="change-tag change-{{ doc.releaseChange }}">{{ doc.releaseChange }} in this edition</span>{% endif %}
      <span class="doc-id-display font-mono">ID: {{ doc.id }}</span>
    </div>
  </div>
</section>

<div class="page-content">
  <div class="container">
    <div class="disclaimer">
      <strong>Disclaimer:</strong> Official sources always prevail. Always refer to EUR-Lex and the publishing body for authoritative texts.
    </div>

    <div class="detail-layout">
      <div>
        <div class="detail-section">
          <h3>Summary</h3>
          <p class="doc-lead">{{ doc.summary or 'No summary available.' }}</p>
        </div>

        <div class="detail-section">
          <h3>Relevance for EUDI</h3>
          <p class="doc-body">{{ doc.relevance_for_eudi or 'Not specified.' }}</p>
        </div>

        {% if doc.status_note %}
        <div class="detail-section">
          <h3>Latest change</h3>
          <p class="doc-body">{{ doc.status_note }}</p>
        </div>
        {% endif %}

        {% if doc.pinned_versions %}
        <div class="detail-section">
          <h3>Pinned versions</h3>
          <p class="doc-body text-secondary">The version other frameworks test or reference may lag the latest one above. Conformance runs should follow the pin of the framework you are assessed against.</p>
          <div class="test-table-wrap">
            <table class="test-table">
              <thead><tr><th scope="col">Pinned by</th><th scope="col">Version</th></tr></thead>
              <tbody>
                {% for pin in doc.pinned_versions %}
                <tr><td><a href="{{ pin.source }}" target="_blank" rel="noopener">{{ pin.by }} ↗</a></td><td class="font-mono">{{ pin.version }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        {% endif %}

        {% set docGroups = documents.docGroups[doc.id] %}
        {% if docGroups and docGroups.length > 0 %}
        <div class="detail-section">
          <h3>Related logical groups</h3>
          <div class="related-list">
            {% for grp in docGroups %}
            <div class="card">
              <strong>{{ grp.groupTitle }}</strong>
              <span>Step: {{ grp.stepTitle }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% set docRoutes = documents.docRoutes[doc.id] %}
        {% if docRoutes and docRoutes.length > 0 %}
        <div class="detail-section">
          <h3>Reading routes</h3>
          <div class="chip-row">
            {% for r in docRoutes %}
            <span class="badge badge-neutral">{{ r.routeTitle }}</span>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>

      <aside class="detail-aside">
        <div class="card">
          <h2 class="detail-aside-title">Details</h2>
          <dl class="dl">
            <dt>Status</dt>
            <dd><span class="status-pill tone-{{ doc.statusTone }}">{{ doc.statusGlyph }} {{ doc.statusLabel }}</span></dd>
            {% if doc.status_date %}
            <dt>Status date</dt>
            <dd class="font-mono">{{ doc.status_date | statusDate }}</dd>
            {% endif %}
            <dt>Type</dt>
            <dd><span class="badge {{ doc.typeBadge }}">{{ doc.typeLabel }}</span></dd>
            <dt>Audience</dt>
            <dd>{% for aud in doc.audience %}<span class="badge badge-neutral">{{ aud }}</span> {% endfor %}</dd>
            {% if doc.arf_essential_for %}
            <dt>ARF essential for</dt>
            <dd><span class="chip-row">{% for cat in doc.arf_essential_for %}<span class="badge badge-technical">★ {{ cat }}</span>{% endfor %}</span></dd>
            {% endif %}
          </dl>
          <div class="detail-actions">
            {% if doc.url %}
            <a href="{{ doc.url }}" class="btn btn-primary btn-md" target="_blank" rel="noopener">Official source ↗</a>
            {% endif %}
            {% if doc.pdf_url %}
            <a href="{{ doc.pdf_url }}" class="btn btn-outline btn-md" target="_blank" rel="noopener">PDF ↗</a>
            {% endif %}
          </div>
        </div>

        {{ credimiCta("Test your implementation against the EUDI rulebook.", "Credimi automates conformance and interoperability runs for Wallets, Issuers and Verifiers and keeps each run as evidence.", true) }}

        <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/data/eudi-documents-map.yaml" class="edit-link" target="_blank" rel="noopener">Suggest a correction on GitHub</a>
      </aside>
    </div>
  </div>
</div>
