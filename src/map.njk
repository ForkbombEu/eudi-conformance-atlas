---
layout: base.njk
title: Map
description: Browse the full EUDI Wallet stack — legal foundations, ARF, EC specifications, standards and protocols — organised by task and by role.
pageScript: tree.js
---
{% from "components/search-box.njk" import searchBox %}
{% from "components/credimi.njk" import credimiCta %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}

<section class="hero page-hero">
  <div class="hero-inner">
    <p class="eyebrow">Interactive map</p>
    <h1>EUDI Document Map</h1>
    <p>Browse the full EUDI stack — from legal foundations to protocol specs — by task. Use <strong>Role</strong> to highlight documents for your role.</p>
  </div>
</section>

<div class="page-content">
  <div class="container">
    {{ breadcrumbs([{label:"Home", url:"/"}, {label:"Map", url:"/map/"}]) }}

    <details class="map-layers">
      <summary class="btn btn-outline btn-sm">Stack layers</summary>
      <div class="layer-stack" id="layer-stack">
        {% for stack in documents.stacks %}
        <div class="layer-row" data-layer="{{ stack.key }}">
          <div class="layer-row-header" role="button" tabindex="0" aria-expanded="false">
            <span class="layer-row-arrow" aria-hidden="true">▶</span>
            <span class="badge {{ stack.badge }}">{{ stack.label }}</span>
            <span class="layer-row-desc">{{ stack.description }}</span>
            <span class="layer-row-count">{{ stack.count }}</span>
          </div>
          <div class="layer-row-body">
            <div class="grouped layer-doc-groups">
              {% for typeGroup in stack.typeGroups %}
              <div class="grouped-block">
                <div class="grouped-rail">
                  <span class="badge {{ typeGroup.badge }}">{{ typeGroup.label }}</span>
                  <span class="grouped-count">{{ typeGroup.count }} {{ 'document' if typeGroup.count === 1 else 'documents' }}</span>
                </div>
                <ul class="grouped-list">
                  {% for doc in typeGroup.docs %}
                  <li class="grouped-row highlightable" data-doc-id="{{ doc.id }}" data-layer="{{ doc.layer }}">
                    <a class="grouped-id mono" href="{{ ('/documents/' + doc.id + '/') | url }}" title="{{ doc.name }}">{{ doc.id }}</a>
                    <span class="grouped-text">{{ (doc.summary or doc.name) | truncate(200) }}</span>
                    <span class="grouped-meta"><span class="status-pill tone-{{ doc.statusTone }}">{{ doc.statusGlyph }} {{ doc.statusLabel }}</span></span>
                  </li>
                  {% endfor %}
                </ul>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
        {% if not loop.last %}<div class="layer-connector" aria-hidden="true">↓</div>{% endif %}
        {% endfor %}
      </div>
    </details>

    <div class="tree-layout">
      <div>
        <div class="mb-4">
          {{ searchBox("tree-search", "Filter tree…") }}
        </div>
        <div class="tree-container" id="tree-container" data-path-prefix="{{ '/' | url }}"></div>
      </div>
      <div id="tree-side-panel" class="tree-side-panel" hidden>
        <button id="tree-panel-close" class="tree-panel-close" aria-label="Close">✕</button>
        <div class="card" id="tree-detail-card"></div>
      </div>
    </div>

    <div class="home-section">
      {{ credimiCta("From map to measurable conformance.", "Issuance, presentation and trust-check steps on this map can be exercised against real Wallets, Issuers and Verifiers with Credimi's automated pipelines.") }}
    </div>

    <div class="disclaimer">
      <strong>Disclaimer:</strong> Unofficial navigation resource. Official sources always prevail.
    </div>

    <div class="page-end">
      <a href="https://github.com/forkbombeu/eudi-conformance-atlas/blob/main/src/map.njk" class="edit-link" target="_blank" rel="noopener">Edit this page on GitHub</a>
    </div>
  </div>
</div>

<script id="tree-data" type="application/json">
{{ { groups: documents.groups, byId: documents.byId, types: documents.types } | toJson | safe }}
</script>

<script>
(function() {
  document.querySelectorAll('.layer-row-header').forEach(function(h) {
    function toggle() {
      var expanded = h.closest('.layer-row').classList.toggle('expanded');
      h.setAttribute('aria-expanded', String(expanded));
    }
    h.addEventListener('click', toggle);
    h.addEventListener('keydown', function(e) { if (e.key==='Enter'||e.key===' ') { e.preventDefault(); toggle(); } });
  });
})();
</script>
